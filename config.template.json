{
    "agents": {
        "defaults": {
            "workspace": "~/.nanobot/workspace",
            "model": "minimax/MiniMax-M2.1",
            "maxTokens": 8192,
            "temperature": 0.7,
            "maxToolIterations": 20,
            "toolResultMaxChars": 8000,
            "compactionEnabled": true,
            "compactionTargetRatio": 0.35
        }
    },
    "channels": {
        "telegram": {
            "enabled": true,
            "token": "在这里填入你的 Telegram Bot Token",
            "allowFrom": [
                "在这里填入允许的用户ID"
            ]
        }
    },
    "providers": {
        "gemini": {
            "apiKey": "在这里填入 Gemini API Key（可选）",
            "apiBase": null
        },
        "minimax": {
            "apiKey": "在这里填入 MiniMax API Key",
            "apiBase": "https://api.minimaxi.com/anthropic"
        },
        "codex": {
            "enabled": false,
            "codexHome": "~/.codex",
            "model": "gpt-5.3-codex",
            "timeout": 300
        }
    },
    "gateway": {
        "host": "0.0.0.0",
        "port": 18790
    },
    "tools": {
        "web": {
            "search": {
                "apiKey": "在这里填入 Brave Search API Key（可选）",
                "maxResults": 5
            }
        },
        "resultStorage": {
            "enabled": true,
            "thresholdChars": 8000,
            "turnBudgetChars": 60000,
            "path": "tool-results",
            "previewChars": 3000
        }
    },
    "search": {
        "enabled": true,
        "autoIndex": false,
        "vectorEnabled": false
    },
    "logging": {
        "level": "INFO",
        "maxFileBytes": 52428800,
        "maxFiles": 3
    }
}
