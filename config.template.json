{
    "agents": {
        "defaults": {
            "workspace": "~/.nanobot/workspace",
            "model": "minimax/MiniMax-M2.1",
            "maxTokens": 8192,
            "temperature": 0.7,
            "maxToolIterations": 20
        }
    },
    "channels": {
        "telegram": {
            "enabled": true,
            "token": "在这里填入你的 Telegram Bot Token",
            "allowFrom": [
                "在这里填入允许的用户ID"
            ]
        }
    },
    "providers": {
        "gemini": {
            "apiKey": "在这里填入 Gemini API Key（可选）",
            "apiBase": null
        },
        "minimax": {
            "apiKey": "在这里填入 MiniMax API Key",
            "apiBase": "https://api.minimaxi.com/anthropic"
        }
    },
    "gateway": {
        "host": "0.0.0.0",
        "port": 18790
    },
    "tools": {
        "web": {
            "search": {
                "apiKey": "在这里填入 Brave Search API Key（可选）",
                "maxResults": 5
            }
        }
    }
}